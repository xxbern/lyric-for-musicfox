// 歌词悬浮窗
// 透明 / 无边框 / 置顶；单行文本 + 8 向偏移描边；静态居中与溢出截断隐藏。

export component LyricWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: true;
    title: "lyric-for-musicfox";
    // 锁死窗口尺寸由 Rust set_size 控制，禁止布局引擎根据子元素 preferred-size 撑大
    preferred-width: 0px;
    preferred-height: 0px;
    min-width: 0px;
    min-height: 0px;

    // —— 隐形测量容器：将 Text preferred-size 完全隔断，不传导给 Window ——
    // Rectangle 固定 width/height 为 0 且 clip，子 Text 可自由伸展以报告 preferred-size
    Rectangle {
        width: 0px;
        height: 0px;
        clip: true;
        measure := Text {
            visible: false;
            text: "......";
            font-size: 24px;
            overflow: clip;
        }
    }

    // —— Rust 侧驱动的属性 ——
    in-out property <string> lyric-text;
    in-out property <length> font-size-px;
    in-out property <string> font-family-name;
    in-out property <int> font-weight;
    in-out property <brush> text-color;
    in-out property <brush> outline-color;
    in-out property <int> outline-width-px;
    out property <length> lyric-text-width: measure.preferred-width;

    property <length> outline-w: outline-width-px * 1px;

    // 双向绑定到测量元素（声明在属性之后以同序解析）
    lyric-text <=> measure.text;
    font-size-px <=> measure.font-size;
    font-family-name <=> measure.font-family;
    font-weight <=> measure.font-weight;

    // 静态排版：未超宽居中，超宽靠左对齐，超出部分由 clip 截断隐藏
    // 使用 preferred-width 计算（measure 元素 width=0，不参与窗口布局）
    property <length> text-natural-w: measure.preferred-width;
    property <length> text-natural-h: measure.preferred-height;
    property <length> display-w: min(text-natural-w, root.width);
    property <length> base-x: text-natural-w > root.width ? 0px : (root.width - text-natural-w) / 2;
    property <length> base-y: (root.height - text-natural-h) / 2;
    out property <bool> has-outline: outline-width-px > 0 && root.outline-color != #00000000;

    callback pointer-pressed();
    callback pointer-released();

    Rectangle {
        width: root.width;
        height: root.height;
        clip: true;

        // —— 8 向偏移描边 ——
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x + root.outline-w;
            y: root.base-y;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x - root.outline-w;
            y: root.base-y;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x;
            y: root.base-y + root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x;
            y: root.base-y - root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x + root.outline-w;
            y: root.base-y + root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x + root.outline-w;
            y: root.base-y - root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x - root.outline-w;
            y: root.base-y + root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x - root.outline-w;
            y: root.base-y - root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x - root.outline-w;
            y: root.base-y + root.outline-w;
        }
        Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.outline-color;
            width: root.display-w;
            height: root.text-natural-h;
            visible: root.has-outline;
            overflow: clip;
            x: root.base-x - root.outline-w;
            y: root.base-y - root.outline-w;
        }

        // —— 主文本 + 拖拽输入 ——
        txt := Text {
            text: root.lyric-text;
            font-size: root.font-size-px;
            font-family: root.font-family-name;
            font-weight: root.font-weight;
            color: root.text-color;
            width: root.display-w;
            height: root.text-natural-h;
            overflow: clip;
            x: root.base-x;
            y: root.base-y;

            TouchArea {
                // 仅解锁（非穿透）时收到事件；locked 由 OS 层 WS_EX_TRANSPARENT 保证
                property <bool> left-down;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        self.left-down = true;
                        root.pointer-pressed();
                    } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                        if (self.left-down) { root.pointer-released(); }
                        self.left-down = false;
                    }
                }
            }
        }
    }
}
